<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.invoiceassistant.backup</string>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_ABSOLUTE_REPO_PATH/backend</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PG_DUMP_BIN</key>
    <string>REPLACE_WITH_ABSOLUTE_POSTGRES_BIN_PATH/pg_dump</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_ABSOLUTE_REPO_PATH/backend/.venv/bin/python</string>
    <string>scripts/backup_recovery.py</string>
    <string>--output-root</string>
    <string>REPLACE_WITH_ABSOLUTE_BACKUP_PATH</string>
    <string>--retention-days</string>
    <string>30</string>
    <string>--prune</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_ABSOLUTE_LOG_PATH/invoice-backup.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_ABSOLUTE_LOG_PATH/invoice-backup.error.log</string>
</dict>
</plist>
