OPENAI_API_KEY=sk-...
SPEECHMATICS_API_KEY=
DATA_DIR=./data
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_URLENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
MAX_UPLOAD_SIZE_MB=20
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=invoices
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=invoices@yourdomain.com
SMTP_FROM_NAME=Invoice Assistant
APP_ENVIRONMENT=development
LOG_LEVEL=INFO
EMAIL_SEND_LIMIT=10
EMAIL_SEND_WINDOW_SECONDS=600
EMAIL_SEND_LEASE_SECONDS=900
INVOICE_GENERATION_LIMIT=15
INVOICE_GENERATION_WINDOW_SECONDS=3600
AI_MONTHLY_TOKEN_LIMIT=2500000
VOICE_MONTHLY_SECONDS=3600
VOICE_HOURLY_REQUEST_LIMIT=10
VOICE_HOURLY_WINDOW_SECONDS=3600
VOICE_MAX_SECONDS_PER_CLIP=180
VOICE_MAX_UPLOAD_MB=8
AI_MAX_PROMPT_CHARS=8000
GLOBAL_DAILY_AI_BUDGET_CENTS=5000
AI_PACK_TOKENS=1000000
VOICE_PACK_SECONDS=3600

# Stripe subscriptions (test mode first). Leave all three blank to disable paid billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# Optional yearly Pro price on the same product.
STRIPE_PRO_YEARLY_PRICE_ID=
# Optional one-time Pro-only top-up prices (payment mode).
STRIPE_AI_PACK_PRICE_ID=
STRIPE_VOICE_PACK_PRICE_ID=
# STRIPE_PRO_PRICE_CENTS / STRIPE_CURRENCY are only a fallback display for when
# billing is disabled. When Stripe is configured the /plans catalog is built from
# the live Price (amount, currency, interval), never from these values.
STRIPE_PRO_PRICE_CENTS=1200
STRIPE_CURRENCY=USD
# Must match the mode of STRIPE_SECRET_KEY: false with sk_test_, true with sk_live_.
# Webhook events whose livemode does not equal this are rejected.
STRIPE_EXPECTED_LIVEMODE=false
FRONTEND_URL=http://localhost:5173
# Keep false until test checkout, webhook updates, cancellation, and portal are verified.
BILLING_ENFORCEMENT_ENABLED=false
# Optional centralized errors. Request bodies, auth/cookies, and user PII are disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
