VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000

# Pre-launch: true serves only the Coming Soon page (set in Vercel Production)
VITE_COMING_SOON=

# Cloudflare Turnstile site key (public). Leave empty to disable CAPTCHA.
# Set it here BEFORE enabling CAPTCHA in Supabase Auth, or sign-in will break.
# Test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Sentry for the website (browser project DSN; public by design). Leave empty to disable.
VITE_SENTRY_DSN=
# Optional; defaults to the Vite mode (development/production).
VITE_SENTRY_ENVIRONMENT=
